    end
end)

-- Kiểm tra Key
BtnCheckKey.MouseButton1Click:Connect(function()
    if KeyInput.Text == CorrectKey then
        KeyStatus.Text = "Key Chính Xác! Đang mở Script..."
        KeyStatus.TextColor3 = Color3.fromRGB(80, 250, 80)
        task.wait(1)
        
        KeyFrame:Destroy() -- Xóa bảng Key
        MainFrame.Visible = true -- Mở Menu Auto Farm
        ToggleButton.Visible = true -- Hiện nút con cá
    else
        KeyStatus.Text = "Key Sai! Vui lòng thử lại."
        KeyStatus.TextColor3 = Color3.fromRGB(250, 80, 80)
    end
end)

RomInput.FocusLost:Connect(function()
    local num = tonumber(RomInput.Text)
    if num and num > 0 then
        Config.TargetRomCount = num
    else
        RomInput.Text = tostring(Config.TargetRomCount)
    end
end)

local function TeleportTo(cframe)
    if cframe and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
        LocalPlayer.Character.HumanoidRootPart.CFrame = cframe
    end
end

local function ClickX10()
    local char = LocalPlayer.Character
    local tool = char and char:FindFirstChildOfClass("Tool")

    for i = 1, 10 do
        if tool then tool:Activate() end
        VirtualInputManager:SendMouseButtonEvent(0, 0, 0, true, game, 0)
        VirtualInputManager:SendMouseButtonEvent(0, 0, 0, false, game, 0)
    end
end

-- Lưu vị trí
BtnSetRomPos.MouseButton1Click:Connect(function()
    if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
        Config.RomCFrame = LocalPlayer.Character.HumanoidRootPart.CFrame
        StatusLabel.Text = "Đã lưu vị trí Đống Rơm!"
        BtnSetRomPos.BackgroundColor3 = Color3.fromRGB(50, 180, 50)
    end
end)

-- Tele Rơm
BtnTeleRom.MouseButton1Click:Connect(function()
    if Config.RomCFrame then
        TeleportTo(Config.RomCFrame)
        StatusLabel.Text = "Đã Tele tới Rơm"
    else
        StatusLabel.Text = "Chưa lưu vị trí Rơm!"
    end
end)

-- Loop Auto Rơm
task.spawn(function()
    while task.wait(0.1) do
        if Config.AutoRom then
            if not Config.RomCFrame then
                StatusLabel.Text = "Hãy đứng ở đống rơm rồi bấm Lưu!"
                Config.AutoRom = false
                BtnRom.Text = "Lụm Rơm: OFF"
                BtnRom.BackgroundColor3 = Color3.fromRGB(180, 50, 50)
                continue
            end

            if Config.CurrentRomCount < Config.TargetRomCount then
                TeleportTo(Config.RomCFrame)
                ClickX10()
                Config.CurrentRomCount = math.min(Config.CurrentRomCount + 10, Config.TargetRomCount)
                BtnRom.Text = "Lụm Rơm (" .. Config.CurrentRomCount .. "/" .. Config.TargetRomCount .. "): ON"
            end
        end
    end
end)

