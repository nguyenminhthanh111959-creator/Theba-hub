-- ============================================
-- 3. KÉO DI CHUYỂN CẢ 2 BẢNG (DRAGGABLE)
-- ============================================
local function makeDraggable(frame)
    local dragging, dragInput, dragStart, startPos
    frame.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPos = frame.Position
            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then dragging = false end
            end)
        end
    end)
    frame.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
            dragInput = input
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if input == dragInput and dragging then
            local delta = input.Position - dragStart
            frame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
        end
    end)
end

makeDraggable(KeyFrame)
makeDraggable(MainFrame)


-- ============================================
-- 4. LOGIC BẤT TỬ, CHỐNG XÉ & PHÁT ĐỎ KHI NHẬN SÁT THƯƠNG
-- ============================================
local isGodMode = false
local lastValidCFrame = nil
local lastHealth = 100
local redTimer = 0

RunService.RenderStepped:Connect(function()
    local char = LocalPlayer.Character
    if char then
        local hrp = char:FindFirstChild("HumanoidRootPart")
        local hum = char:FindFirstChildOfClass("Humanoid")
        
        -- Theo dõi máu để nhận diện khi bị dính sát thương
        if hum then
            if hum.Health < lastHealth then
                redTimer = 0.3 -- Thời gian phát đỏ (giây)
            end
            lastHealth = hum.Health
        end

        -- Hiệu ứng phát đỏ các bộ phận trên cơ thể khi dính đòn
        if redTimer > 0 then
            redTimer = redTimer - RunService.RenderStepped:Wait()
            for _, part in ipairs(char:GetChildren()) do
                if part:IsA("BasePart") then
                    part.Color = Color3.fromRGB(255, 0, 0)
                end
            end
        end

        if isGodMode then
            if hum then
                hum.MaxHealth = 100000
                hum.Health = 100000
                lastHealth = hum.Health -- Giữ đồng bộ máu ảo
                hum:SetStateEnabled(Enum.HumanoidStateType.Dead, false)
                hum:SetStateEnabled(Enum.HumanoidStateType.FallingDown, false)
                hum:SetStateEnabled(Enum.HumanoidStateType.Ragdoll, false)
                hum.BreakJointsOnDeath = false
            end
            
            if hrp then
                if hrp.Position.Y < -500 then
                    if lastValidCFrame then
                        hrp.CFrame = lastValidCFrame
                    else
                        hrp.CFrame = CFrame.new(0, 50, 0)
                    end
                    hrp.Velocity = Vector3.new(0, 0, 0)
                else
                    local currentCF = hrp.CFrame
                    if lastValidCFrame and (currentCF.Position - lastValidCFrame.Position).Magnitude > 150 then
                        hrp.CFrame = lastValidCFrame
                        hrp.Velocity = Vector3.new(0, 0, 0)
                    else
                        lastValidCFrame = currentCF
                    end
                end
            end
        else
            if hrp then
                lastValidCFrame = hrp.CFrame
            end
        end
    end
end)

ToggleBtn.MouseButton1Click:Connect(function()
    isGodMode = not isGodMode
    
    if isGodMode then
        ToggleBtn.Text = "BẤT TỬ: BẬT"
        ToggleBtn.BackgroundColor3 = Color3.fromRGB(40, 180, 80)
        
        local char = LocalPlayer.Character
        if char and char:FindFirstChildOfClass("Humanoid") then
            char.Humanoid.MaxHealth = 100000
            char.Humanoid.Health = 100000
            lastHealth = char.Humanoid.Health
        end
    else
        ToggleBtn.Text = "BẤT TỬ: TẮT"
        ToggleBtn.BackgroundColor3 = Color3.fromRGB(180, 40, 40)
        
        local char = LocalPlayer.Character
        if char and char:FindFirstChildOfClass("Humanoid") then
            local hum = char:FindFirstChildOfClass("Humanoid")
            hum.MaxHealth = 100
            hum.Health = 100
            lastHealth = hum.Health
            hum:SetStateEnabled(Enum.HumanoidStateType.Dead, true)
            hum:SetStateEnabled(Enum.HumanoidStateType.FallingDown, true)
            hum:SetStateEnabled(Enum.HumanoidStateType.Ragdoll, true)
            hum.BreakJointsOnDeath = true
        end
    end
end)
